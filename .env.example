# FixGraph Environment Configuration Example

ENV=development
LOG_LEVEL=INFO
HOST=0.0.0.0
PORT=8000

# LLM Provider configuration (openai, azure, stub, mock)
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.0

# Embedding model configuration
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
SIMILARITY_THRESHOLD=0.82

# Storage paths
CACHE_DB_PATH=data/cache.db
CHALLENGE_ASSETS_DIR=challenge_assets
DEEPLINKS_PATH=challenge_assets/deeplinks.json
QUERIES_PATH=challenge_assets/queries.json
SIIS_PATH=challenge_assets/siis_responses.json

# Performance & Timeouts (ms)
CACHE_HIT_P95_LIMIT_MS=300
COLD_PATH_P95_LIMIT_MS=8000
